{
  "name": "example-next-isr-with-swr",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "routes": [
    { "pattern": "example-next-isr-with-swr.joebell.studio", "custom_domain": true }
  ],
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
